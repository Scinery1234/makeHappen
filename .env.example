# Required for the chat and suggestion features. Without it the steps still work.
ANTHROPIC_API_KEY=

# Optional
# PORT=3000
# WAYFINDER_MODEL=claude-opus-5-5          # chat, idea lists, plan, first steps
# WAYFINDER_QUICK_MODEL=claude-haiku-5-5   # one-off "suggest an idea for this mix"
# WAYFINDER_FALLBACKS=on                   # set to "off" to disable server-side refusal fallback
# RATE_LIMIT_PER_MIN=20                    # AI requests per IP per minute
# TRUST_PROXY=1                            # set when behind a reverse proxy so rate limits see real IPs
